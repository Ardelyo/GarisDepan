{
  "name": "garis-depan",
  "version": "0.1.0",
  "private": true,
  "description": "GARIS DEPAN — game strategi peta: gambar perintah langsung di peta, giliran simultan (WEGO), hot-seat 2–8 pemain.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "node -e \"process.env.GD_BALANCE=1;require('child_process').execSync('npx vitest run',{stdio:'inherit',env:process.env})\""
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
