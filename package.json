{
  "name": "garis-depan",
  "version": "0.1.0",
  "private": true,
  "description": "GARIS DEPAN — game strategi peta: gambar perintah langsung di peta, giliran simultan (WEGO), hot-seat 2–8 pemain.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "node -e \"process.env.GD_BALANCE=1;require('child_process').execSync('npx vitest run',{stdio:'inherit',env:process.env})\"",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  },
  "main": "electron/main.cjs",
  "author": "Ardelyo",
  "build": {
    "appId": "com.ardelyo.garisdepan",
    "productName": "Garis Depan",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Garis Depan"
    },
    "portable": {
      "artifactName": "GarisDepan-Portable-${version}.exe"
    }
  }
}
